# Copiar a .env y rellenar. NUNCA subir .env a git.
# No pongas aquí contraseñas, códigos 2FA ni frases semilla: el sistema no los necesita.

# Modo de operación: OBSERVATION | RECOMMENDATION | AUTOMATIC
JMC_MODE=OBSERVATION
# Interruptor adicional obligatorio para el modo AUTOMATIC (Fase 9). Mantener en false.
JMC_AUTO_MODE_ENABLED=false

# Margen neto mínimo del ciclo compra→venta en % (ya descontadas comisiones y 4x1000). Ej.: 1 = 1 % libre.
JMC_MARGEN_MIN=1

# Meta de ganancia diaria (COP) y tope mensual exento de 4x1000 (COP). Acepta 18.330.900.
JMC_META_DIARIA=127.000
JMC_TOPE_EXENTO=
# Cuentas que comparten ese tope (por defecto, las que tienen 4x1000 = 0 en JMC_MY_PAY_METHODS).
JMC_CUENTAS_EXENTAS=
# Fecha en que empezaste como comerciante COP (AAAA-MM-DD): la rentabilidad cuenta desde ahí.
JMC_INICIO_COMERCIANTE=

# Competencia para puestos y precios: true = solo comerciantes verificados; false = todos.
JMC_SOLO_VERIFICADOS=true

# Mercado
JMC_ASSET=USDT
JMC_FIAT=COP

# Tus métodos de pago y el 4x1000 que te cobran al pagar desde cada uno (0 = exento).
JMC_MY_PAY_METHODS=DaviviendaSA:0,Daviplata:0,BancolombiaSA:0.004,Nequi:0.004

# API key de SOLO LECTURA ("Enable Reading"), con restricción por IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# API key de gestión de anuncios (SOLO en Fase 9). Sin permiso de retiros. Dejar vacío.
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=

# Alertas por Telegram (Fase 6). Configúralas con:  jmcambios-alertas configurar
# Solo ENVÍAN avisos; el bot no recibe órdenes ni puede tocar tu cuenta.
JMC_TELEGRAM_BOT_TOKEN=
JMC_TELEGRAM_CHAT_ID=

# Alertas por correo (opcional). Con Gmail usa una "contraseña de aplicación", nunca tu contraseña normal.
JMC_EMAIL_SMTP_HOST=
JMC_EMAIL_SMTP_PORT=587
JMC_EMAIL_USER=
JMC_EMAIL_PASSWORD=
JMC_EMAIL_TO=

# Clave del panel web (se genera sola la primera vez que abres el panel).
JMC_DASHBOARD_TOKEN=

# Tolerancia de tiempo de la firma (ms)
BINANCE_RECV_WINDOW=10000
# Timeout HTTP (s)
BINANCE_HTTP_TIMEOUT=15
