# Copiar a .env y rellenar. NUNCA subir .env a git.
# No pongas aquí contraseñas, códigos 2FA ni frases semilla: el sistema no los necesita.

# Modo de operación: OBSERVATION | RECOMMENDATION | AUTOMATIC
JMC_MODE=OBSERVATION
# Interruptor adicional obligatorio para el modo AUTOMATIC (Fase 9). Mantener en false.
JMC_AUTO_MODE_ENABLED=false

# Mercado
JMC_ASSET=USDT
JMC_FIAT=COP

# Tus métodos de pago y el 4x1000 que te cobran al pagar desde cada uno (0 = exento).
JMC_MY_PAY_METHODS=DaviviendaSA:0,Daviplata:0,BancolombiaSA:0.004,Nequi:0.004

# API key de SOLO LECTURA ("Enable Reading"), con restricción por IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# API key de gestión de anuncios (SOLO en Fase 9). Sin permiso de retiros. Dejar vacío.
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=

# Tolerancia de tiempo de la firma (ms)
BINANCE_RECV_WINDOW=10000
# Timeout HTTP (s)
BINANCE_HTTP_TIMEOUT=15
